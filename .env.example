# Supabase browser/server configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-side Supabase request timeout. Defaults to 3000ms.
SUPABASE_REQUEST_TIMEOUT_MS=

# Server-side default model configuration.
# Users can override this per browser in the Preferences page; those overrides stay in browser localStorage.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Optional total AI generation budget. Defaults: 1 day 30s, 5 days 60s, 7 days 90s.
OPENAI_REQUEST_TIMEOUT_MS=

# Optional server-side AMap WebService fallback for nearby restaurant search.
# If omitted, users can configure their own Web Service Key on /nearby.
# Never expose the server key through NEXT_PUBLIC_* variables.
AMAP_WEB_SERVICE_KEY=
# Optional upstream request timeout. Defaults to 8000ms; allowed range: 1000-30000ms.
AMAP_REQUEST_TIMEOUT_MS=
# Optional aggregate daily protection for the server public AMap key.
# Counts upstream request units, not button clicks. 0/omitted/invalid disables this app-side limit.
# Recommended starting value: 150 (about 50 complete GPS locate-and-search flows per day).
AMAP_PUBLIC_DAILY_REQUEST_LIMIT=150
# Daily reset time zone. Invalid values fall back to Asia/Shanghai.
AMAP_PUBLIC_QUOTA_TIME_ZONE=Asia/Shanghai
# Separate production/staging counters when they share the same Supabase project.
AMAP_PUBLIC_QUOTA_BUCKET=production

# Supabase Auth + WeChat Official Account binding
# Configure Email/Password auth in Supabase. The WeChat server callback URL is:
#   https://YOUR_DOMAIN/api/wechat/callback
# Use plain-text message mode unless encrypted-message verification is implemented separately.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
# Temporary parameter QR code lifetime, in seconds. Defaults to 600.
WECHAT_QR_EXPIRE_SECONDS=600

# Official Account reply-code login. Users follow the account, reply 【登录】,
# and enter the returned 6-digit code on /account. Enabled by default when Token + HMAC secret exist.
WECHAT_CODE_LOGIN_ENABLED=true
# Automatic scan login needs WeChat API access from a whitelisted fixed egress IP.
WECHAT_SCAN_LOGIN_ENABLED=false
# Optional public display name and a stable official-account QR image URL/path.
# If QR URL is empty, the bundled public/wechat-official-account-qr.png image is used.
WECHAT_PUBLIC_ACCOUNT_NAME=烟火食间
WECHAT_PUBLIC_ACCOUNT_QR_URL=/wechat-official-account-qr.png
# High-entropy server-only secret used to HMAC OpenID subjects, login codes and rate-limit keys.
WECHAT_LOGIN_HMAC_SECRET=
# Reply code validity, resend cooldown, and browser verification limit per 10-minute window.
WECHAT_CODE_LOGIN_TTL_SECONDS=600
WECHAT_CODE_LOGIN_COOLDOWN_SECONDS=30
WECHAT_CODE_LOGIN_MAX_ATTEMPTS=8

# Legacy WeChat webpage OAuth login is intentionally abandoned and disabled.
# Only set this explicit OAuth-only switch to true if the Official Account becomes eligible later.
WECHAT_OAUTH_LOGIN_ENABLED=false
# Deprecated compatibility variable; it no longer enables OAuth login.
WECHAT_LOGIN_ENABLED=false
WECHAT_OAUTH_REDIRECT_URI=
WECHAT_LOGIN_CHALLENGE_TTL_SECONDS=300
# Active follow-status checks also need a whitelisted fixed egress IP. Callback events remain authoritative when disabled.
WECHAT_FOLLOW_STATUS_REFRESH_ENABLED=false
# Re-check the Official Account follow state after this many seconds. Defaults to 6 hours.
WECHAT_FOLLOW_STATUS_FRESH_SECONDS=21600
# Fail closed when a refresh fails and cached status is older than this. Defaults to 24 hours.
WECHAT_FOLLOW_STATUS_MAX_STALE_SECONDS=86400
# Timeout for WeChat API calls. Defaults to 8000ms.
WECHAT_REQUEST_TIMEOUT_MS=8000
